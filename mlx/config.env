# ==============================================================================
#  MLX 本地模型服务配置
#
#  所有端口和环境变量的统一配置
# ==============================================================================

# 端口配置
MLX_UNIFIED_PORT="${MLX_UNIFIED_PORT:-4100}"    # 统一代理端口（对外）
MLX_SERVER_PORT="${MLX_SERVER_PORT:-8080}"      # 推理服务端口（本地）

# 性能配置
MLX_REQUEST_TIMEOUT="${MLX_REQUEST_TIMEOUT:-1800}"  # 请求超时（秒）

# 认证配置（可选）
MLX_AUTH_TOKEN="${MLX_AUTH_TOKEN:-}"  # API认证令牌（为空则不启用认证）

# 路径配置
MLX_HOME="${MLX_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
MLX_VENV="${MLX_VENV:-$MLX_HOME/venv}"
MLX_LOGS="${MLX_LOGS:-$MLX_HOME/logs}"
MLX_MODELS="${MLX_MODELS:-$MLX_HOME/models}"
MLX_STATE="${MLX_STATE:-$MLX_HOME/state}"

# 模型配置
MLX_DEFAULT_MODEL="${MLX_DEFAULT_MODEL:-14b}"
