#!/usr/bin/env bash
# 薄壳：实现见 src/cli/opencode-local.ts（dist 存在走 node，否则 tsx 直跑源码）
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
if [ -f "$ROOT/dist/cli/opencode-local.js" ]; then exec node "$ROOT/dist/cli/opencode-local.js" "$@"; fi
exec npx --yes tsx "$ROOT/src/cli/opencode-local.ts" "$@"
