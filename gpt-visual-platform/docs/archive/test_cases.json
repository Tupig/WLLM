          "description": "测试从任务创建到执行完成的完整Unity测试流程",
          "preconditions": ["项目已安装所有依赖", "编排服务已启动", "Unity Editor已安装"],
          "input": {
            "job_create": {"platform": "mac", "required_skills": ["PlayMode"], "unity_project_path": "/path/to/unity/project", "test_filter": "TestSuite.*"},
            "agent_register": {"platform": "mac", "skills": ["PlayMode"]},
            "agent_poll": {"platform": "mac", "skills": ["PlayMode"]},
            "agent_submit": {"success": true, "summary": {"tests_run": 5, "tests_passed": 5}}
          },
          "expected_output": "任务创建成功，Agent拉取并执行任务，执行完成后上报结果",
          "actual_output": "",
          "result": ""
        },
        {
          "id": "BT-002",
          "name": "测试完整的Web测试流程",
          "description": "测试从任务创建到执行完成的完整Web测试流程",
          "preconditions": ["项目已安装所有依赖", "编排服务已启动", "浏览器已安装"],
          "input": {
            "job_create": {"platform": "web", "required_skills": ["Playwright"], "extra": {"url": "https://example.com", "browser": "chromium", "headless": true}},
            "agent_register": {"platform": "web", "skills": ["Playwright", "WebChrome"]},
            "agent_poll": {"platform": "web", "skills": ["Playwright", "WebChrome"]},
            "agent_submit": {"success": true, "summary": {"url": "https://example.com", "browser": "chromium", "status": "passed"}}
          },
          "expected_output": "任务创建成功，Web Agent拉取并执行任务，执行完成后上报结果",
          "actual_output": "",
          "result": ""
