          "preconditions": ["项目已安装所有依赖", "编排服务已启动", "MCP服务已启动", "Unity Editor已安装"],
          "input": {
            "job_create": {"platform": "mac", "required_skills": ["PlayMode"], "extra": {"use_mcp": true, "test_filter": "TestSuite.*"}},
            "agent_register": {"platform": "mac", "skills": ["PlayMode"]},
            "agent_poll": {"platform": "mac", "skills": ["PlayMode"]},
            "agent_submit": {"success": true, "summary": {"message": "MCP test run", "result": {"tests_run": 5, "tests_passed": 5}}}
          },
          "expected_output": "任务创建成功，Agent通过MCP执行测试，执行完成后上报结果",
